{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.MSSqlServer"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server = .; Database = SchoolProjectDB ; Integrated Security = SSPI; TrustServerCertificate = True;MultipleActiveResultSets=True",
          "sinkOptionsSection": {
            "tableName": "SystemLogs",
            "autoCreateSqlTable": true,
            "autoCreateSqlDatabase": true
          }
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server = .; Database = SchoolProjectDB ; Integrated Security = SSPI; TrustServerCertificate = True;MultipleActiveResultSets=True"
  },
  "JwtSettings": {
    "Key": "ThisIsMySuperSecretKeyForSchoolProjectThatIsAtLeast32CharsLong!",
    "Issuer": "SchoolProjectApi",
    "Audience": "SchoolProjectClient",
    "DurationInMinutes": 60,
    "RefreshTokenDurationInDays": 30,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
  "EmailSettings": {
    "Email": "hgahmed731@gmail.com",
    "Password": "qdtwznrbfwgtbnfs",
    "Host": "smtp.gmail.com",
    "Port": 587
  }
}
